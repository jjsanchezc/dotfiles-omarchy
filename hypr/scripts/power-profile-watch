#!/bin/bash

# Recarga Hyprland cuando cambia el perfil de energía (cargador, menú o Fn+F5),
# para que hypr/power-saver.lua ponga o quite los ajustes de ahorro.

gdbus monitor --system --dest net.hadess.PowerProfiles --object-path /net/hadess/PowerProfiles |
  while read -r line; do
    [[ $line == *"'ActiveProfile'"* ]] && hyprctl reload >/dev/null
  done
