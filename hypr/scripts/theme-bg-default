#!/bin/bash

# Guarda el fondo actual como predeterminado del tema actual. Al cambiar de
# tema, Omarchy pone la primera imagen (por nombre) de
# ~/.config/omarchy/backgrounds/<tema>/, así que se copia ahí como 0-default.

theme=$(cat ~/.local/state/omarchy/current/theme.name 2>/dev/null)
bg=$(readlink -f ~/.local/state/omarchy/current/background)
dir=~/.config/omarchy/backgrounds/$theme

if [[ -z $theme || ! -f $bg ]]; then
  omarchy-notification-send "No hay un fondo para guardar" -t 2000
  exit 1
fi

new="$dir/0-default.${bg##*.}"
if [[ $bg != "$new" ]]; then
  mkdir -p "$dir"
  rm -f "$dir"/0-default.*
  cp "$bg" "$new"
fi

omarchy-notification-send "Fondo predeterminado guardado" "Tema: $theme" -t 2000
