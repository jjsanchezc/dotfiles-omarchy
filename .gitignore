# Todo está ignorado por defecto: aquí viven datos privados (zen/ tiene
# contraseñas y cookies). Solo se suben las rutas que se habilitan con "!".
/*
!/.gitignore
!/README.md

# Hyprland: atajos, pantallas, touchpad y apariencia
!/hypr/
/hypr/*
!/hypr/hyprland.lua
!/hypr/bindings.lua
!/hypr/monitors.lua
!/hypr/input.lua
!/hypr/looknfeel.lua
!/hypr/autostart.lua

# Omarchy: barra, tamaño de texto, menú y plugins propios
!/omarchy/
/omarchy/*
!/omarchy/shell.json
!/omarchy/shell.toml
!/omarchy/extensions/
!/omarchy/plugins/
# Plugin de terceros con su propio repo; se reinstala con:
#   git clone https://github.com/andreireanu/omarchy-minimal-monitor.git ~/.config/omarchy/plugins/io.github.andreireanu.minimal-monitor
/omarchy/plugins/io.github.andreireanu.minimal-monitor/

# Terminales
!/kitty/
!/foot/

# tmux (los plugins se descargan con Prefijo + I)
!/tmux/
/tmux/plugins/

# Neovim
!/nvim/

# Herramientas
!/mise/
!/git/
