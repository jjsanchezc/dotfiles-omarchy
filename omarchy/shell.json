{
  "version": 1,
  "idle": {
    "screensaver": 240,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Bogota",
              "zone": "America/Bogota"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "io.github.twiking.omacontrol",
          "showActiveSwitchCount": false
        }
      ],
      "center": [
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "io.github.andreireanu.minimal-monitor",
          "showTemp": false,
          "showFans": false
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.microphone"
        }
      ],
      "tray": []
    }
  },
  "plugins": [
    {
      "id": "jjsanchezc.image-picker"
    },
    {
      "id": "jjsanchezc.notifications"
    }
  ],
  "disabledPlugins": [
    "omarchy.image-picker",
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "jjsanchezc.image-picker",
    "jjsanchezc.notifications"
  ]
}
